#!/bin/sh
# Extract a versioned rootfs under an exclusive lock; mark only complete results.
set -eu
DEST=${1:-${ELF2_SYSROOT_DIR:-/cache/elf2-sysroot}}
ROOTFS=${ELF2_ROOTFS_IMAGE:-/opt/elf2-deps/prebuilts/elfboard/buildroot/rootfs.ext4}
[ -f "$ROOTFS" ] || { echo "缺少 rootfs：$ROOTFS" >&2; exit 1; }
mkdir -p "$DEST"
DEST=$(realpath "$DEST")
exec 9>"$DEST/.extract.lock"
flock 9
fingerprint=$(sha256sum "$ROOTFS")
fingerprint=${fingerprint%% *}
if [ -f "$DEST/.complete" ] && [ "$(cat "$DEST/.complete")" = "$fingerprint" ]; then
    echo "目标 sysroot 已展开：$DEST"
    exit 0
fi
# Do not overwrite a previously exposed sysroot or merge an interrupted extraction.
if find "$DEST" -mindepth 1 -maxdepth 1 ! -name .extract.lock | grep -q .; then
    echo "目标目录非空或 rootfs 版本已变化，请指定新的空目录：$DEST" >&2
    exit 1
fi
STAGING=$(mktemp -d "$DEST/.extract-XXXXXX")
trap 'rm -rf "$STAGING"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# debugfs may return 0 even when rdump fails. Treat any diagnostic beyond its
# version banner as a failure; never mark a partial extraction complete.
mkdir "$STAGING/root"
LC_ALL=C debugfs -R "rdump / $STAGING/root" "$ROOTFS" >"$STAGING/stdout" 2>"$STAGING/stderr"
if grep -v '^debugfs [0-9]' "$STAGING/stderr" | grep -q .; then
    cat "$STAGING/stderr" >&2
    exit 1
fi
[ -d "$STAGING/root/usr" ] && [ -d "$STAGING/root/lib" ]
# Keep the extraction in its version directory and expose entries via symlinks.
mv "$STAGING/root" "$DEST/$fingerprint"
for entry in "$DEST/$fingerprint"/* "$DEST/$fingerprint"/.[!.]* "$DEST/$fingerprint"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    ln -s "$fingerprint/${entry##*/}" "$DEST/${entry##*/}"
done
printf '%s\n' "$fingerprint" > "$DEST/.complete"
echo "完成：--sysroot=$DEST"
